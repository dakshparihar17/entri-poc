# ==========================
# Python & FastAPI Project
# ==========================

# --- Python cache & virtual environment ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.so
*.egg
*.egg-info/
.env
.venv/
venv/
env/
build/
dist/

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE / Editor files ---
.vscode/
.idea/
*.swp

# ==========================
# Application specific ignores
# ==========================

# --- Runtime data (all JSON files in data/ are gitignored; folder is tracked via .gitkeep) ---
backend/data/*.json
!backend/data/.gitkeep

# --- Uploaded or generated media ---
backend/uploads/
backend/faces/
backend/live_faces/
backend/tickets/


# --- Sensitive configs & environment ---
.env
*.env
secrets.json
config.json

# --- Logs & temporary files ---
*.log
logs/
tmp/
temp/
__temp__/
*.bak

# --- Database files (if any) ---
*.db
*.sqlite3

# --- Test / Debug outputs ---
test_output/
debug/
*.tmp
.claude/
